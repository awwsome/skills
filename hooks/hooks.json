{
  "description": "adhd 모드가 켜진 세션에서만 매 턴과 대화 요약 직후에 상기 문구를 넣는다",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/adhd-mode-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/adhd-mode-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
